#!/usr/bin/env bash
# afx-guard portable git hooks — post-checkout.
# Installed via `core.hooksPath .githooks` (scripts/afx-guard/afx-hooks-install.sh).
# Fires on `git checkout`/`git switch` (branch or file checkout — we only
# care about branch switches) and on the initial checkout of a fresh clone.
set -u
prev_head="${1:-}" new_head="${2:-}" is_branch_checkout="${3:-}"

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"

if command -v git-lfs >/dev/null 2>&1 && [ -n "$ROOT" ] && git -C "$ROOT" grep -q "filter=lfs" -- .gitattributes 2>/dev/null; then
  git lfs post-checkout "$@" || true
fi

[ "$is_branch_checkout" != "1" ] && exit 0
[ -n "$ROOT" ] && [ -x "$ROOT/scripts/trunk-sync/sync-check.sh" ] && "$ROOT/scripts/trunk-sync/sync-check.sh"

# --- always on origin/main (owner rule 2026-10-15): read-only advisory, never blocks, no network. ---
_AFX_WS="$ROOT/scripts/afx-guard/afx-workspace-status.sh"
[ -f "$_AFX_WS" ] || _AFX_WS="$HOME/.claude/hooks/afx-guard/afx-workspace-status.sh"
[ -f "$_AFX_WS" ] && bash "$_AFX_WS" "$ROOT" --hook-line --no-fetch >&2 2>/dev/null || true

exit 0
