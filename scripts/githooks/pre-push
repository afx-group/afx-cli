#!/usr/bin/env bash
# afx-guard portable git hooks — pre-push.
# Installed via `core.hooksPath .githooks` (scripts/afx-guard/afx-hooks-install.sh).
# Same file, byte-for-byte, across the hub, afx-template and every venture repo.
#
# Skip for a deliberate one-off: AFX_HOOKS_SKIP=1 git push ...
set -u

[ "${AFX_HOOKS_SKIP:-0}" = "1" ] && exit 0
[ "${TRUNK_SYNC_SKIP_GUARD:-0}" = "1" ] && exit 0   # legacy escape hatch name, honored too

PROTECTED="${AFX_HOOKS_PROTECTED_BRANCHES:-${TRUNK_SYNC_PROTECTED_BRANCHES:-main master staging}}"
ZERO="0000000000000000000000000000000000000000"
ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"

# git-lfs interop: if this repo actually uses LFS (references filter=lfs
# anywhere in .gitattributes) and git-lfs is installed, chain to it first —
# some repos in this portfolio (the hub, for one .gif asset) do use LFS, and
# this hook must not silently replace that behavior.
if command -v git-lfs >/dev/null 2>&1 && [ -n "$ROOT" ] && git -C "$ROOT" grep -q "filter=lfs" -- .gitattributes 2>/dev/null; then
  git lfs pre-push "$@" || exit $?
fi

# git only invokes this hook with the ref list on stdin once — read it once
# here and reuse it for every check below.
STDIN_LINES="$(cat)"

# afx-mcp-server smoke check — hub-specific, but harmless everywhere else
# (no-ops when lib/afx-mcp-server doesn't exist in this repo). Added
# 2026-09-20 after GitHub Actions billing broke portfolio-wide with no
# advance warning: a red check three commits later is a much worse time to
# find out the MCP server doesn't boot than a few seconds before the push
# that broke it.
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "${local_ref:-}" ] && continue
  [ "$local_sha" = "$ZERO" ] && continue  # branch delete
  branch="${remote_ref#refs/heads/}"
  case "$branch" in
    feat/mcp-*|feat/*mcp*) ;;
    *) continue ;;
  esac
  [ -n "$ROOT" ] && [ -d "$ROOT/lib/afx-mcp-server" ] || continue
  base="$remote_sha"
  [ "$base" = "$ZERO" ] && base="$(git merge-base "$local_sha" HEAD~50 2>/dev/null || echo "$local_sha")"
  if ! git diff --quiet "$base" "$local_sha" -- lib/afx-mcp-server 2>/dev/null; then
    echo "" >&2
    echo "afx-mcp-server changed on branch '$branch' — running pnpm run smoke before push..." >&2
    if ! (cd "$ROOT/lib/afx-mcp-server" && pnpm run smoke >&2); then
      echo "" >&2
      echo "BLOCKED: pnpm run smoke failed in lib/afx-mcp-server." >&2
      echo "Fix it, or if you're certain this push is fine: AFX_HOOKS_SKIP=1 git push ..." >&2
      exit 1
    fi
  fi
done <<< "$STDIN_LINES"

# --- L-012: refuse a push that doesn't include origin's CURRENT tip ---
# 2026-09-20: two independent actors (a Replit Agent and a session on
# this Mac) pushed to origin/main the same day, touching the same two files.
# A concurrent Replit-side agent pushing to a shared branch is a real third
# actor, not a hypothetical. This is deliberately NOT limited to the
# protected-branch list below: git only rejects a non-fast-forward push at
# the protocol level for branches this hook explicitly protects (or ones the
# remote itself is configured to protect) — an ordinary, non-"main/staging"
# shared branch (e.g. a lane/wip branch two agents both touched) accepts a
# force-push with no native git objection at all. A fresh `git fetch` of
# THIS branch, done right now (not trusting any cached remote-tracking ref,
# which may predate a concurrent actor's push, or may not exist yet if this
# machine never fetched the branch), is the only way to know what a push is
# about to discard.
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "${local_ref:-}" ] && continue
  [ "$local_sha" = "$ZERO" ] && continue  # branch delete
  branch="${remote_ref#refs/heads/}"
  [ -z "$branch" ] && continue
  if ! git fetch -q origin "$branch" 2>/dev/null; then
    continue   # can't reach origin (offline, auth) — let the push itself surface that error
  fi
  fresh_remote_sha="$(git rev-parse -q --verify FETCH_HEAD 2>/dev/null || true)"
  [ -z "$fresh_remote_sha" ] && continue   # branch doesn't exist on origin yet — nothing to be behind
  if ! git merge-base --is-ancestor "$fresh_remote_sha" "$local_sha" 2>/dev/null; then
    echo "" >&2
    echo "BLOCKED (L-012): origin/$branch is currently at $fresh_remote_sha, and this push" >&2
    echo "  does not include that commit — it would discard work that's on origin right now." >&2
    echo "  A concurrent actor (a Replit Agent, or another session) may have pushed" >&2
    echo "  independently — this has happened for real on this portfolio (one venture," >&2
    echo "  2026-09-20: two different authors pushed to main the same day, touching" >&2
    echo "  the same files)." >&2
    echo "  git log --oneline HEAD..origin/$branch   # see what you'd otherwise discard" >&2
    echo "  then rebase/merge before pushing. Deliberate override:" >&2
    echo "  AFX_HOOKS_SKIP=1 git push ..." >&2
    exit 1
  fi
done <<< "$STDIN_LINES"

# --- Force-push protection on protected branches ---
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "${local_ref:-}" ] && continue
  [ "$local_sha" = "$ZERO" ] && continue  # branch delete
  branch="${remote_ref#refs/heads/}"
  is_protected=0
  for b in $PROTECTED; do
    [ "$branch" = "$b" ] && is_protected=1
  done
  [ "$is_protected" -eq 0 ] && continue

  if [ "$remote_sha" != "$ZERO" ]; then
    if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
      echo "" >&2
      echo "BLOCKED: non-fast-forward (force) push to protected branch '$branch'." >&2
      echo "This is exactly the class of action that turns a divergence into" >&2
      echo "an unrecoverable one." >&2
      echo "" >&2
      echo "If prod needs to go back:" >&2
      echo "  git revert -m 1 <merge-sha>   (then push normally)" >&2
      echo "not a force-push or hard-reset of a shared branch." >&2
      echo "" >&2
      echo "If you are certain this is safe (e.g. a genuine local mistake" >&2
      echo "nobody else has pulled yet), re-run with:" >&2
      echo "  AFX_HOOKS_SKIP=1 git push ..." >&2
      exit 1
    fi
  fi
done <<< "$STDIN_LINES"

exit 0
