{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "AFX: workspace status (stay on origin/main)",
      "type": "shell",
      "command": "f=scripts/afx-guard/afx-workspace-status.sh; [ -f \"$f\" ] || f=\"$HOME/.claude/hooks/afx-guard/afx-workspace-status.sh\"; bash \"$f\" \"${workspaceFolder}\" --fetch || true",
